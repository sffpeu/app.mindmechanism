rules_version = '2';

// Single-owner lockdown.
//
// Nothing in this database is readable or writable by anyone except the owner.
// This is enforced by Google, on Google's servers, before any query runs. It
// does not depend on the website, so it holds even for someone signing in to
// Firebase directly with a saved copy of the public web config, and it holds
// for tokens issued before this file was published.
//
// The previous version of this file ended with a catch-all
// `match /{document=**} { allow read: if isAuthenticated() }`. Firestore rules
// are additive, so that one line granted every signed-in account read access to
// every document, overriding all the per-user restrictions above it.
//
// Server code using the Firebase Admin SDK bypasses these rules entirely, so
// the API routes and the Vercel cron continue to work.
//
// To restore multi-user access later, reinstate the per-collection rules from
// git history and delete this file's catch-all, rather than loosening isOwner().

service cloud.firestore {
  match /databases/{database}/documents {

    // The owner, identified by the email on the Firebase token.
    //
    // Matching on email rather than uid means this survives the account being
    // recreated, and needed no console lookup to write. Nobody else can hold
    // this email on a token, because the address is already registered to the
    // owner's account and Firebase will not issue a second account for it.
    //
    // Stricter alternative, once the uid is to hand:
    //   return request.auth != null && request.auth.uid == 'THE_UID';
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'future@theoneleggedpoet.com';
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
